pipeline {
    agent {
        kubernetes {
            cloud 'kind-sales-ai'
            defaultContainer 'jnlp'
            slaveConnectTimeout 300
            showRawYaml false

            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    app.kubernetes.io/part-of: sales-ai
    app.kubernetes.io/component: jenkins-agent
spec:
  serviceAccountName: jenkins-agent
  automountServiceAccountToken: false
  restartPolicy: Never
  terminationGracePeriodSeconds: 30

  nodeSelector:
    salesiq.io/node-pool: applications

  securityContext:
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 1000
    fsGroup: 1000
    seccompProfile:
      type: RuntimeDefault

  containers:
    - name: jnlp
      image: jenkins/inbound-agent:3391.va_37fa_a_305d6d-6-alpine3.24-jdk21
      imagePullPolicy: IfNotPresent
      workingDir: /home/jenkins/agent

      env:
        - name: JAVA_TOOL_OPTIONS
          value: "-Xms64m -Xmx256m"
        - name: K8S_NODE_NAME
          valueFrom:
            fieldRef:
              fieldPath: spec.nodeName

      resources:
        requests:
          cpu: "100m"
          memory: "256Mi"
        limits:
          cpu: "500m"
          memory: "512Mi"

      securityContext:
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities:
          drop:
            - ALL

      volumeMounts:
        - name: temporary-files
          mountPath: /tmp

    - name: nodejs
      image: node:22.23.4-alpine3.24
      imagePullPolicy: IfNotPresent
      workingDir: /home/jenkins/agent

      command:
        - sleep
      args:
        - "7d"

      env:
        - name: CI
          value: "true"
        - name: NPM_CONFIG_CACHE
          value: "/tmp/npm-cache"
        - name: NODE_OPTIONS
          value: "--max-old-space-size=768"
        - name: VITE_API_BASE_URL
          value: "/api"

      resources:
        requests:
          cpu: "250m"
          memory: "256Mi"
        limits:
          cpu: "1000m"
          memory: "1Gi"

      securityContext:
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities:
          drop:
            - ALL

      volumeMounts:
        - name: temporary-files
          mountPath: /tmp


    - name: python
      image: python:3.12.15-bookworm
      imagePullPolicy: IfNotPresent
      workingDir: /home/jenkins/agent

      command:
        - sleep
      args:
        - "7d"

      env:
        - name: HOME
          value: "/tmp"
        - name: USER
          value: "jenkins"
        - name: PYTHONUNBUFFERED
          value: "1"
        - name: PYTHONDONTWRITEBYTECODE
          value: "1"
        - name: PIP_DISABLE_PIP_VERSION_CHECK
          value: "1"
        - name: PIP_CACHE_DIR
          value: "/tmp/pip-cache"

      resources:
        requests:
          cpu: "100m"
          memory: "256Mi"
        limits:
          cpu: "1000m"
          memory: "1Gi"

      securityContext:
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities:
          drop:
            - ALL

      volumeMounts:
        - name: temporary-files
          mountPath: /tmp


    - name: buildctl
      image: moby/buildkit:v0.34.1
      imagePullPolicy: IfNotPresent
      workingDir: /home/jenkins/agent

      command:
        - sleep
      args:
        - "7d"

      env:
        - name: HOME
          value: "/tmp"

      resources:
        requests:
          cpu: "50m"
          memory: "64Mi"
        limits:
          cpu: "250m"
          memory: "256Mi"

      securityContext:
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities:
          drop:
            - ALL

      volumeMounts:
        - name: temporary-files
          mountPath: /tmp
        - name: buildkit-client-tls
          mountPath: /certs
          readOnly: true

  volumes:
    - name: temporary-files
      emptyDir: {}
    - name: buildkit-client-tls
      secret:
        secretName: buildkit-client-tls
        defaultMode: 0440
'''
        }
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        skipDefaultCheckout(true)
    }

    environment {
        BACKEND_IMAGE = 'ghcr.io/rs6739171-hash/sales-ai-backend'
        FRONTEND_IMAGE = 'ghcr.io/rs6739171-hash/sales-ai-frontend'
        SOURCE_REPOSITORY = 'https://github.com/rs6739171-hash/sales_ai_project'
    }

    stages {
        stage('Checkout source') {
            steps {
                script {
                    def checkoutResult = checkout scm

                    env.SOURCE_COMMIT = checkoutResult.GIT_COMMIT

                    currentBuild.description =
                        "main@${env.SOURCE_COMMIT.take(12)}"
                }

                sh '''
                    set -eu

                    echo "Agent Pod: $HOSTNAME"
                    echo "Kubernetes node: $K8S_NODE_NAME"
                    echo "Checked-out commit: $SOURCE_COMMIT"

                    test -f backend/main.py
                    test -f backend/requirements.txt
                    test -f backend/requirements-dev.txt
                    test -f backend/tests/test_api.py
                    test -f backend/dockerfile
                    test -f frontend/package.json
                    test -f frontend/package-lock.json
                    test -f frontend/dockerfile
                    test -f frontend/nginx.conf

                    git rev-parse HEAD > source-commit.txt
                    git ls-files > source-files.txt

                    echo "PASS: Expected source files exist."
                '''
            }
        }



        stage('Verify BuildKit connection') {
            options {
                timeout(time: 2, unit: 'MINUTES')
            }
            steps {
                container('buildctl') {
                    sh '''
                        set -eu

                        buildctl --version
                        test -r /certs/ca.pem
                        test -r /certs/cert.pem
                        test -r /certs/key.pem
                        mkdir -p ci-reports

                        buildctl \
                            --addr=tcp://buildkitd.jenkins-agents.svc.cluster.local:1234 \
                            --tlscacert=/certs/ca.pem \
                            --tlscert=/certs/cert.pem \
                            --tlskey=/certs/key.pem \
                            debug workers > ci-reports/buildkit-workers.txt

                        test -s ci-reports/buildkit-workers.txt
                        cat ci-reports/buildkit-workers.txt

                        echo "PASS: Jenkins agent connected to BuildKit using mutual TLS."
                    '''
                }
            }
        }

        stage('Install backend dependencies') {
            steps {
                container('python') {
                    dir('backend') {
                        sh '''
                            set -eu
                            python --version
                            python -m venv .ci-venv
                            .ci-venv/bin/python -m pip install -r requirements-dev.txt
                            mkdir -p test-results
                            .ci-venv/bin/python -m pip freeze > test-results/backend-packages.txt
                        '''
                    }
                }
            }
        }

        stage('Backend API tests') {
            steps {
                container('python') {
                    dir('backend') {
                        sh '''
                            set -eu
                            .ci-venv/bin/python -m pytest tests -v --junitxml=test-results/backend.xml
                        '''
                    }
                }
            }

            post {
                always {
                    junit(
                        testResults: 'backend/test-results/backend.xml',
                        allowEmptyResults: false,
                        skipPublishingChecks: true
                    )
                }
            }
        }

        stage('Install frontend dependencies') {
            steps {
                container('nodejs') {
                    dir('frontend') {
                        sh '''
                            set -eu
                            node --version
                            npm --version
                            npm ci
                        '''
                    }
                }
            }
        }

        stage('Frontend tests') {
            steps {
                container('nodejs') {
                    dir('frontend') {
                        sh '''
                            set -eu
                            mkdir -p test-results
                            npm run test -- --maxWorkers=1 --reporter=default --reporter=junit --outputFile.junit=test-results/vitest.xml
                        '''
                    }
                }
            }

            post {
                always {
                    junit(
                        testResults: 'frontend/test-results/vitest.xml',
                        allowEmptyResults: false,
                        skipPublishingChecks: true
                    )
                }
            }
        }

        stage('Compile frontend') {
            steps {
                container('nodejs') {
                    dir('frontend') {
                        sh '''
                            set -eu

                            npm run build
                            test -s dist/index.html

                            tar -czf frontend-dist.tar.gz -C dist .
                            sha256sum frontend-dist.tar.gz > frontend-dist.tar.gz.sha256

                            echo "PASS: Frontend compiled and packaged."
                        '''
                    }
                }
            }
        }


        stage('Build and publish backend image') {
            options {
                timeout(time: 20, unit: 'MINUTES')
            }
            steps {
                container('buildctl') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'ghcr-publisher',
                            usernameVariable: 'GHCR_USERNAME',
                            passwordVariable: 'GHCR_TOKEN'
                        )
                    ]) {
                        sh '''
                            set +x
                            set -eu
                            umask 077

                            test -f backend/.dockerignore
                            test -f backend/dockerfile
                            test -n "$GHCR_USERNAME"
                            test -n "$GHCR_TOKEN"
                            mkdir -p ci-reports

                            export DOCKER_CONFIG
                            DOCKER_CONFIG="$(mktemp -d /tmp/ghcr-auth.XXXXXX)"
                            trap 'rm -rf "$DOCKER_CONFIG"' EXIT

                            registry_auth="$(printf '%s:%s' "$GHCR_USERNAME" "$GHCR_TOKEN" | base64 | tr -d '[:space:]')"
                            printf '{"auths":{"ghcr.io":{"auth":"%s"}}}' "$registry_auth" > "$DOCKER_CONFIG/config.json"
                            unset registry_auth GHCR_USERNAME GHCR_TOKEN

                            buildctl \
                                --addr=tcp://buildkitd.jenkins-agents.svc.cluster.local:1234 \
                                --tlscacert=/certs/ca.pem \
                                --tlscert=/certs/cert.pem \
                                --tlskey=/certs/key.pem \
                                build \
                                --progress=plain \
                                --frontend=dockerfile.v0 \
                                --local context=backend \
                                --local dockerfile=backend \
                                --opt filename=dockerfile \
                                --opt platform=linux/amd64 \
                                --opt "label:org.opencontainers.image.source=$SOURCE_REPOSITORY" \
                                --opt "label:org.opencontainers.image.revision=$SOURCE_COMMIT" \
                                --output "type=image,name=$BACKEND_IMAGE:$SOURCE_COMMIT,push=true" \
                                --metadata-file ci-reports/backend-image-metadata.json
                        '''
                    }
                }

                container('python') {
                    sh '''
                        set -eu
                        python - <<'PY'
import json
import os
import re
from pathlib import Path

reports = Path("ci-reports")
metadata = json.loads((reports / "backend-image-metadata.json").read_text())
digest = metadata.get("containerimage.digest", "")
if not re.fullmatch(r"sha256:[0-9a-f]{64}", digest):
    raise SystemExit("BuildKit did not return a valid image digest.")

image = os.environ["BACKEND_IMAGE"]
commit = os.environ["SOURCE_COMMIT"]
record = {
    "repository": image,
    "source_repository": os.environ["SOURCE_REPOSITORY"],
    "source_commit": commit,
    "platform": "linux/amd64",
    "tag": f"{image}:{commit}",
    "digest": digest,
    "reference": f"{image}@{digest}",
}
(reports / "backend-image.json").write_text(json.dumps(record, indent=2) + chr(10))
print("Published tag: " + record["tag"])
print("Published digest: " + record["reference"])
print("PASS: Backend image published to GHCR.")
PY
                    '''
                }
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'ci-reports/backend-image-metadata.json,ci-reports/backend-image.json',
                        allowEmptyArchive: true,
                        fingerprint: true
                    )
                }
            }
        }

        stage('Build and publish frontend image') {
            options {
                timeout(time: 15, unit: 'MINUTES')
            }
            steps {
                container('buildctl') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'ghcr-publisher',
                            usernameVariable: 'GHCR_USERNAME',
                            passwordVariable: 'GHCR_TOKEN'
                        )
                    ]) {
                        sh '''
                            set +x
                            set -eu
                            umask 077

                            test -f frontend/.dockerignore
                            test -f frontend/dockerfile
                            test -n "$GHCR_USERNAME"
                            test -n "$GHCR_TOKEN"
                            mkdir -p ci-reports

                            export DOCKER_CONFIG
                            DOCKER_CONFIG="$(mktemp -d /tmp/ghcr-auth.XXXXXX)"
                            trap 'rm -rf "$DOCKER_CONFIG"' EXIT

                            registry_auth="$(printf '%s:%s' "$GHCR_USERNAME" "$GHCR_TOKEN" | base64 | tr -d '[:space:]')"
                            printf '{"auths":{"ghcr.io":{"auth":"%s"}}}' "$registry_auth" > "$DOCKER_CONFIG/config.json"
                            unset registry_auth GHCR_USERNAME GHCR_TOKEN

                            buildctl \
                                --addr=tcp://buildkitd.jenkins-agents.svc.cluster.local:1234 \
                                --tlscacert=/certs/ca.pem \
                                --tlscert=/certs/cert.pem \
                                --tlskey=/certs/key.pem \
                                build \
                                --progress=plain \
                                --frontend=dockerfile.v0 \
                                --local context=frontend \
                                --local dockerfile=frontend \
                                --opt filename=dockerfile \
                                --opt platform=linux/amd64 \
                                --opt "label:org.opencontainers.image.source=$SOURCE_REPOSITORY" \
                                --opt "label:org.opencontainers.image.revision=$SOURCE_COMMIT" \
                                --output "type=image,name=$FRONTEND_IMAGE:$SOURCE_COMMIT,push=true" \
                                --metadata-file ci-reports/frontend-image-metadata.json
                        '''
                    }
                }

                container('python') {
                    sh '''
                        set -eu
                        python - <<'PY'
import json
import os
import re
from pathlib import Path

reports = Path("ci-reports")
metadata = json.loads((reports / "frontend-image-metadata.json").read_text())
digest = metadata.get("containerimage.digest", "")
if not re.fullmatch(r"sha256:[0-9a-f]{64}", digest):
    raise SystemExit("BuildKit did not return a valid image digest.")

image = os.environ["FRONTEND_IMAGE"]
commit = os.environ["SOURCE_COMMIT"]
record = {
    "repository": image,
    "source_repository": os.environ["SOURCE_REPOSITORY"],
    "source_commit": commit,
    "platform": "linux/amd64",
    "tag": f"{image}:{commit}",
    "digest": digest,
    "reference": f"{image}@{digest}",
}
(reports / "frontend-image.json").write_text(json.dumps(record, indent=2) + chr(10))
print("Published tag: " + record["tag"])
print("Published digest: " + record["reference"])
print("PASS: Frontend image published to GHCR.")
PY
                    '''
                }
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'ci-reports/frontend-image-metadata.json,ci-reports/frontend-image.json',
                        allowEmptyArchive: true,
                        fingerprint: true
                    )
                }
            }
        }

        stage('Archive build outputs') {
            steps {
                archiveArtifacts(
                    artifacts: 'ci-reports/buildkit-workers.txt,source-commit.txt,source-files.txt,frontend/frontend-dist.tar.gz,frontend/frontend-dist.tar.gz.sha256,backend/test-results/backend-packages.txt',
                    fingerprint: true
                )
            }
        }
    }
}
